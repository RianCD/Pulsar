# Copie para .env na raiz do repositorio e substitua os exemplos.
# Carregado pelo Spring Boot como Java Properties; nao use export nem aspas.
# Use a senha literal, sem codificacao de URL. Para uma barra invertida, use \\.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=SUBSTITUA_PELA_NOVA_SENHA
MEDIASTACK_API_ACCESS_KEY=SUBSTITUA_PELA_NOVA_CHAVE

# Opcionais: descomente apenas os valores que deseja alterar em dev.
# O perfil dev e padrao. Para prod, defina SPRING_PROFILES_ACTIVE no ambiente.
# MEDIASTACK_API_URL=https://api.mediastack.com/v1/news
# MEDIASTACK_API_LIMIT=3
# MEDIASTACK_API_CONNECT_TIMEOUT=PT10S
# MEDIASTACK_API_READ_TIMEOUT=PT30S
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL=all-minilm
# OLLAMA_CHAT_TIMEOUT=PT2M
# OLLAMA_EMBEDDING_TIMEOUT=PT2M
# OLLAMA_TEMPERATURE=0.3
# PULSAR_NEWS_COLLECTION_ENABLED=false
# PULSAR_NEWS_COLLECTION_INTERVAL=PT1H
# PULSAR_NEWS_COLLECTION_INITIAL_DELAY=PT30S
